# Public-site hardening for Apache/XAMPP.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Deny application code and private data before any clean-URL mapping.
    RewriteRule ^(?:config|database|includes|storage|tools|tmp|output|\.git)(?:/|$) - [F,L,NC]
    # Preserve bearer credentials for the native scanner API under Apache/FastCGI.
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    # Serve extensionless page URLs (/admin/home) from their PHP files.
    # Physical .php URLs keep working too; no folder name is hardcoded, so the
    # rules behave the same under /biometric, /biometric-system, or web root.
    RewriteRule ^index$ index.php [END]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [END]

</IfModule>

<IfModule mod_authz_core.c>
    # Never serve configuration, backups, logs, source helpers, or caches.
    <FilesMatch "\.(?:bak|conf|env|ini|log|md|py|pkl|sql|yml|yaml)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
